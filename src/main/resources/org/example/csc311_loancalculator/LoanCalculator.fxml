<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>

<!-- Main Layout Grid matching assignment design -->
<GridPane hgap="10.0" vgap="10.0" alignment="CENTER"
          xmlns="http://javafx.com/javafx/21"
          xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="org.example.csc311_loancalculator.LoanCalculatorController">
    <padding>
        <Insets top="15.0" right="15.0" bottom="15.0" left="15.0" />
    </padding>

    <!-- Labels -->
    <Label text="Annual Interest Rate:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
    <Label text="Number of Years:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
    <Label text="Loan Amount:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
    <Label text="Monthly Payment:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
    <Label text="Total Payment:" GridPane.columnIndex="0" GridPane.rowIndex="4" />

    <!-- Text Fields -->
    <TextField fx:id="interestRateField" alignment="CENTER_RIGHT" GridPane.columnIndex="1" GridPane.rowIndex="0" />
    <TextField fx:id="yearsField" alignment="CENTER_RIGHT" GridPane.columnIndex="1" GridPane.rowIndex="1" />
    <TextField fx:id="loanAmountField" alignment="CENTER_RIGHT" GridPane.columnIndex="1" GridPane.rowIndex="2" />

    <!-- Read-only Output Fields -->
    <TextField fx:id="monthlyPaymentField" alignment="CENTER_RIGHT" editable="false" focusTraversable="false" GridPane.columnIndex="1" GridPane.rowIndex="3" />
    <TextField fx:id="totalPaymentField" alignment="CENTER_RIGHT" editable="false" focusTraversable="false" GridPane.columnIndex="1" GridPane.rowIndex="4" />

    <!-- Calculator Button -->
    <Button text="Calculator" onAction="#handleCalculate" GridPane.columnIndex="1" GridPane.rowIndex="5" GridPane.halignment="RIGHT" />
</GridPane>